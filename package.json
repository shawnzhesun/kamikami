{
  "name": "kamikami",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"vite --host 127.0.0.1\"",
    "server": "node --watch --import tsx server/index.ts",
    "desktop": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4318/api/health && electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:service": "node --import tsx tests/service-smoke.ts",
    "format": "prettier --write src server tests electron",
    "mcp": "node server/mcp.mjs",
    "test:mcp": "node --import tsx tests/mcp-smoke.ts",
    "test:e2e": "node --import tsx tests/mcp-e2e.ts",
    "test:ui": "node --import tsx tests/timeline-ui-smoke.mjs",
    "test:ui:keyframes": "node --import tsx tests/keyframes-ui-smoke.mjs",
    "test:text-render": "node --import tsx tests/text-effects-render-smoke.mjs",
    "test:kinetic-render": "node --import tsx tests/kinetic-render-smoke.mjs",
    "test:mcp:full": "node --import tsx tests/mcp-comprehensive.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/bundler": "4.0.533",
    "@remotion/paths": "^4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "openai": "^7.30.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.533",
    "roughjs": "^4.6.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "44.5.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "productName": "KamiKami"
}
